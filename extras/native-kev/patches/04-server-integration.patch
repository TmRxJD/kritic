--- a/examples/laya/src/router.cpp
+++ b/examples/laya/src/router.cpp
@@ -6,9 +6,67 @@
 #include <filesystem>
 #include <iostream>
 #include <stdexcept>
+#include <fstream>
+#ifdef _WIN32
+#define NOMINMAX
+#include <windows.h>
+#endif
 
 namespace laya {
 namespace fs = std::filesystem;
+static double monotonic_seconds() {
+    return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+static std::optional<uint64_t> available_commit() {
+#ifdef _WIN32
+    MEMORYSTATUSEX status{};
+    status.dwLength = sizeof(status);
+    if (GlobalMemoryStatusEx(&status)) return status.ullAvailPageFile;
+#endif
+    // Unknown pressure never authorizes an automatic promotion.
+    return std::nullopt;
+}
+
+bool DecisionRouter::memory_reserved() const { return reservations_.active(monotonic_seconds()) != 0; }
+JsonValue DecisionRouter::memory_control(const JsonValue& request, bool reserve) {
+    const auto* id = request.get("id");
+    const auto* owner = request.get("owner");
+    if (!id || !id->is_string() || !owner || !owner->is_string())
+        throw std::invalid_argument("id and owner strings are required");
+    bool changed;
+    if (reserve) {
+        const auto* ttl = request.get("ttl_seconds");
+        if (!ttl || !ttl->is_number() || !std::isfinite(ttl->n) || ttl->n < 1 ||
+            ttl->n > 3600 || std::floor(ttl->n) != ttl->n)
+            throw std::invalid_argument("ttl_seconds must be an integer from 1 to 3600");
+        changed = reservations_.reserve(id->s, owner->s, static_cast<int>(ttl->n), monotonic_seconds());
+        if (changed) { engines_.clear(); memory_policy_.reset_idle(); }
+    } else changed = reservations_.release(id->s, owner->s, monotonic_seconds());
+    JsonValue out = JsonValue::object();
+    out.set("id", JsonValue::string(id->s));
+    out.set(reserve ? "reserved" : "released", JsonValue::boolean(changed));
+    return out;
+}
+
+void DecisionRouter::select_memory_profile(const std::string& family) {
+    if (memory_profile_ != "auto") return;
+    auto& engine = ensure(family);
+    if (memory_policy_.streaming_supported() != engine.supports_weight_streaming())
+        memory_policy_ = MemoryPolicy(engine.supports_weight_streaming());
+    size_t free = 0, total = 0;
+    MemoryHeadroom headroom;
+    headroom.available_commit_bytes = available_commit();
+    if (engine.device_memory(free, total)) headroom.free_vram_bytes = free;
+    const auto choice = memory_policy_.select(monotonic_seconds(), headroom);
+    const bool streaming = choice.profile == MemoryProfile::Streaming;
+    if (choice.changed) {
+        engines_.clear();
+        std::cerr << "[laya] memory profile -> " << (streaming ? "low-commit" : "high-commit")
+                  << " (" << choice.reason << ")\n";
+    }
+    opt_.stream_weights = streaming;
+}
+
 
