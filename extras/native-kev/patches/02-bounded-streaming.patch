diff --git a/runtime/include/ggmlc/weight_streaming.h b/runtime/include/ggmlc/weight_streaming.h
new file mode 100644
index 0000000..47595dd
--- /dev/null
+++ b/runtime/include/ggmlc/weight_streaming.h
@@ -0,0 +1,75 @@
+#pragma once
+
+#include "ggmlc/types.h"
+#include <limits>
+#include <unordered_map>
+#include <unordered_set>
+
+namespace ggmlc {
+
+// Conservative pre-allocation admission for auto mode. Runtime weight_slices()
+// remains authoritative after lowering: this does not promise every dynamic
+// shape/backend operation will succeed. Unknown streamed consumers stay resident.
+inline bool weight_streaming_graph_eligible(const SerializedModelGraph& graph) {
+    std::unordered_map<uint32_t, uint32_t> roots;
+    std::unordered_set<uint32_t> available;
+    for (const auto& pair : graph.tensors) {
+        const auto& t = pair.second;
+        if (t.storage != StorageClass::ACTIVATION && t.storage != StorageClass::OUTPUT) available.insert(pair.first);
+        if (t.storage != StorageClass::PARAMETER || t.type != GGML_TYPE_Q8_0) continue;
+        // Literal dimensions avoid evaluating malformed/overflowing expression
+        // trees in an eligibility probe. Nonliteral weights stay resident.
+        for (const auto& dim : t.ne) {
+            if (!dim || dim->type != DimType::STATIC || dim->val <= 0) return false;
+        }
+        if (t.ne[1]->val <= 1) continue;
+        if (t.ne[0]->val % ggml_blck_size(t.type) != 0) return false;
+        size_t bytes = ggml_row_size(t.type, t.ne[0]->val);
+        for (int d = 1; d < 4; ++d) {
+            if (static_cast<uint64_t>(t.ne[d]->val) > std::numeric_limits<size_t>::max() / bytes) return false;
+            bytes *= static_cast<size_t>(t.ne[d]->val);
+        }
+        if (bytes >= 1024 * 1024) {
+            if (!t.data_ptr || t.data_size < bytes) return false;
+            roots.emplace(pair.first, pair.first);
+        }
+    }
+    if (roots.empty()) return false;
+    for (const auto& op : graph.ops) {
+        bool has_root = false;
+        uint32_t root = 0;
+        for (uint32_t input : op.inputs) {
+            if (!available.count(input)) return false;
+            const auto found = roots.find(input);
+            if (found == roots.end()) continue;
+            if (has_root && root != found->second) return false;
+            has_root = true;
+            root = found->second;
+        }
+        for (uint32_t output : op.outputs) {
+            if (roots.count(output)) return false; // immutable parameter/view write
+        }
+        const bool view = op.opcode == GGML_OP_VIEW || op.opcode == GGML_OP_RESHAPE ||
+            op.opcode == GGML_OP_PERMUTE || op.opcode == GGML_OP_TRANSPOSE;
+        if (has_root) {
+            // These known lowerings read weights or create metadata/copies.
+            // SET/ACC/SET_ROWS/custom consumers require explicit future review.
+            if (!view && op.opcode != GGML_OP_MUL_MAT && op.opcode != GGML_OP_GET_ROWS &&
+                op.opcode != GGML_OP_CONT && op.opcode != GGML_OP_DUP && op.opcode != GGML_OP_CPY) return false;
+            if (op.opcode == GGML_OP_CPY && op.inputs.size() > 1 && roots.count(op.inputs[1])) return false;
+            const auto inplace = op.attributes.find("inplace");
+            if (inplace != op.attributes.end() && inplace->second != 0) return false;
+            if (view) {
+                if (op.inputs.empty() || !roots.count(op.inputs[0])) return false;
+                for (uint32_t output : op.outputs) roots.emplace(output, root);
+            }
+        }
+        for (uint32_t output : op.outputs) available.insert(output);
+    }
+    for (uint32_t output : graph.outputs) {
+        if (roots.count(output)) return false;
+    }
+    return true;
+}
+
+} // namespace ggmlc
