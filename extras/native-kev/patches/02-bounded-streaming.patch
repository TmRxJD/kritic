+            // CPY writes src[1], including when its result view is not yet initialized.
+            if (node->op == GGML_OP_CPY && streamed_root(node->src[1])) {
+                throw std::runtime_error("Weight streaming cannot copy into a streamed weight: " + std::string(node->name));
+            }
+            struct ggml_tensor* required = nullptr;
+            for (auto* src : node->src) {
+                auto* root = streamed_root(src);
+                if (!root) continue;
+                if (required && required != root) {
+                    throw std::runtime_error("Weight streaming node requires multiple streamed weights: " + std::string(node->name));
+                }
+                required = root;
+            }
+            if (required && active.weight && required != active.weight) {
+                active.end = i;
+                slices.push_back(active);
+                active = {i, i, required};
+            } else if (required) {
+                active.weight = required;
+            }
+        }
