+#include "ggmlc/weight_streaming.h"
+#include <iostream>
+#include <stdexcept>
+
+static void require(bool value, const char* error) {
+    if (!value) throw std::runtime_error(error);
+}
+
+static ggmlc::SerializedModelGraph model(ggml_type type = GGML_TYPE_Q8_0, int width = 1024) {
+    ggmlc::SerializedModelGraph graph;
+    static const uint8_t data = 0; // probe inspects metadata only, never dereferences bytes
+    for (uint32_t id = 0; id < 5; ++id) {
+        ggmlc::SerializedTensor tensor{};
+        tensor.id = id;
+        tensor.type = id == 1 || id == 2 ? type : GGML_TYPE_F32;
+        tensor.storage = id == 0 ? ggmlc::StorageClass::INPUT : id <= 2 ? ggmlc::StorageClass::PARAMETER : ggmlc::StorageClass::ACTIVATION;
+        for (int d = 0; d < 4; ++d) {
+            tensor.ne[d] = std::make_shared<ggmlc::DimExpr>();
+            tensor.ne[d]->type = ggmlc::DimType::STATIC;
+            tensor.ne[d]->val = d < 2 ? width : 1;
+        }
+        tensor.data_ptr = &data;
+        tensor.data_size = ggml_row_size(type, width) * width;
+        graph.tensors[id] = tensor;
+    }
+    graph.inputs = {0};
+    graph.outputs = {4};
+    graph.ops = {{0, GGML_OP_MUL_MAT, "first", {1, 0}, {3}, {}, {}},
+                 {1, GGML_OP_MUL_MAT, "second", {2, 3}, {4}, {}, {}}};
+    return graph;
+}
+
+int main() {
+    using ggmlc::weight_streaming_graph_eligible;
+    require(weight_streaming_graph_eligible(model()), "ordinary Q8 matrices rejected");
+    require(!weight_streaming_graph_eligible(model(GGML_TYPE_Q4_0)), "Q4-only model admitted");
+    require(!weight_streaming_graph_eligible(model(GGML_TYPE_F16)), "F16-only model admitted");
+    require(!weight_streaming_graph_eligible(model(GGML_TYPE_Q8_0, 32)), "small Q8 weights admitted");
+    auto graph = model();
+    graph.ops[0].inputs = {1, 2};
+    require(!weight_streaming_graph_eligible(graph), "two streamed roots admitted");
+    graph = model();
+    graph.ops[0] = {0, GGML_OP_RESHAPE, "alias", {1}, {3}, {}, {}};
+    require(!weight_streaming_graph_eligible(graph), "view hid a second streamed root");
+    graph.ops[1].inputs = {3, 0};
+    require(weight_streaming_graph_eligible(graph), "one view root rejected");
+    graph.outputs = {3};
+    require(!weight_streaming_graph_eligible(graph), "output alias admitted");
+    graph = model();
+    graph.ops[0].outputs = {1};
+    require(!weight_streaming_graph_eligible(graph), "weight write admitted");
+    graph = model();
+    graph.ops[0].opcode = GGML_OP_SET_ROWS;
+    require(!weight_streaming_graph_eligible(graph), "unknown writable weight consumer admitted");
+    graph = model();
+    graph.tensors[1].data_size = 1;
+    require(!weight_streaming_graph_eligible(graph), "truncated weight admitted");
+    std::cout << "Weight streaming eligibility checks passed\n";
+}
