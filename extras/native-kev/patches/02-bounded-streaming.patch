+    // Never allocate per slice: residuals, KV/state writes and activation reuse
+    // must retain the original graph's complete dependency/liveness ordering.
+    const auto slices = weight_slices();
+    size_t transferred = 0;
+    for (const auto& slice : slices) {
+        if (slice.weight) {
+            const auto& source = model_graph_.tensors.at(streamed_weights_.at(slice.weight));
+            const size_t bytes = ggml_nbytes(slice.weight);
+            constexpr size_t chunk_bytes = 16 * 1024 * 1024;
