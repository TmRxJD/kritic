+                *legacy_assigned.tensors.at(0).data_ptr == 3,
+                "legacy data_buffer pointers rebase within their source array");
+    }
+    {
+        auto truncated = copied;
+        truncated.tensors.at(1).data_size = 1;
+        ggmlc::ModelExecutor rejected(truncated, "cpu");
+        for (int repeat = 0; repeat < 8; ++repeat) {
+            fails([&] { rejected.prepare({}); }, "truncated weight must fail initialization");
+            // Configuration is permitted only before initialization allocates
+            // anything. Acceptance here proves the failed attempt rolled back.
+            rejected.set_weight_streaming(false);
+        }
+    }
+    // Executor keeps a graph copy alive, including after repeated prepare/run.
+    {
+        ggmlc::ModelExecutor executor(copied, "cpu");
+        copied = {};
+        assigned = {};
+        require(!owner.expired(), "executor retains mapping");
+        const float input[] = {2, 3};
+        for (int repeat = 0; repeat < 3; ++repeat) {
+            const auto storage = owner.lock();
+            require(storage != nullptr, "mapped storage remains owned by executor");
+            storage->release_residency();
+            executor.prepare({});
+            executor.set_input(0, input, sizeof(input));
+            executor.run(1);
+            const auto* out = static_cast<const float*>(executor.get_output_data(2));
+            require(std::abs(out[0] - 8) < 1e-5f && std::abs(out[1] - 18) < 1e-5f,
+                    "mapped CPU inference mismatch");
+        }
+    }
+    require(owner.expired(), "last graph/executor releases mapping");
+    // Failed parses must release their mapping too: Windows permits deletion only afterwards.
+    const auto bad = path.string() + ".truncated";
+    std::ifstream fresh(path, std::ios::binary);
+    bytes.assign(std::istreambuf_iterator<char>(fresh), {});
+    fresh.close();
+    const auto truncated_size = static_cast<size_t>(owned_copy.data_offset + hidden_offset) + sizeof(values) - 1;
+    for (size_t length : {size_t(0), size_t(8), truncated_size}) {
+        std::ofstream truncated(bad, std::ios::binary | std::ios::trunc);
+        truncated.write(reinterpret_cast<const char*>(bytes.data()), length);
+        truncated.close();
+        fails([&] { ggmlc::ModelLoader::load_from_file(bad); }, "truncated file accepted");
+        require(std::filesystem::remove(bad), "failed parse leaked file mapping");
+    }
+    fails([&] { ggmlc::ModelLoader::load_from_memory(nullptr, 0); }, "empty memory accepted");
+    fails([&] { ggmlc::ModelLoader::load_from_memory(bytes.data(), truncated_size); }, "truncated memory accepted");
+    fails([&] { ggmlc::ModelLoader::load_from_file(path.string() + ".missing"); }, "missing file accepted");
+    const auto json_start = std::search(bytes.begin(), bytes.end(), spec.begin(), spec.end());
+    require(json_start != bytes.end(), "locate graph metadata");
+    *json_start = '!';
+    {
+        std::ofstream invalid(bad, std::ios::binary);
+        invalid.write(reinterpret_cast<const char*>(bytes.data()), bytes.size());
+    }
+    fails([&] { ggmlc::ModelLoader::load_from_file(bad); }, "invalid graph JSON accepted");
+    require(std::filesystem::remove(bad), "JSON exception leaked mapping");
+    owned_copy = {};
+    require(std::filesystem::remove(path), "mapping handle remained open");
+    std::cout << "loader: mapped/owned bytes, graph copies, executor lifetime, CPU inference, truncation pass\n";
+}
