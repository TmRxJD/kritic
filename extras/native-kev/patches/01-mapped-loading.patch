diff --git a/runtime/include/ggmlc/model_data.h b/runtime/include/ggmlc/model_data.h
new file mode 100644
index 0000000..b77a497
--- /dev/null
+++ b/runtime/include/ggmlc/model_data.h
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace ggmlc {
+
+// Shared ownership keeps tensor pointers valid across graph and executor copies.
+// File mappings are read-only and remain mapped for the last graph's lifetime.
+class ModelData {
+public:
+    virtual ~ModelData() = default;
+    virtual const uint8_t* data() const noexcept = 0;
+    virtual size_t size() const noexcept = 0;
+    // Best-effort release of clean file pages after GPU upload. The mapping and
+    // tensor pointers stay valid; owned buffers intentionally do nothing.
+    virtual void release_residency() const noexcept {}
+    static std::shared_ptr<ModelData> map_file(const std::string& filepath);
+    static std::shared_ptr<ModelData> copy(const uint8_t* data, size_t size);
+    static std::shared_ptr<ModelData> read_file(const std::string& filepath);
+};
+
+} // namespace ggmlc
diff --git a/runtime/src/model_data.cpp b/runtime/src/model_data.cpp
new file mode 100644
index 0000000..e613ce0
--- /dev/null
+++ b/runtime/src/model_data.cpp
@@ -0,0 +1,128 @@
+#include "ggmlc/model_data.h"
+
+#include <cerrno>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <limits>
+#include <stdexcept>
+#include <system_error>
+
+#ifdef _WIN32
+#define NOMINMAX
+#include <windows.h>
+#else
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#endif
+
+namespace ggmlc {
+namespace {
+class OwnedModelData final : public ModelData {
+public:
+    std::vector<uint8_t> bytes;
+    const uint8_t* data() const noexcept override { return bytes.data(); }
+    size_t size() const noexcept override { return bytes.size(); }
+};
+
+class MappedModelData final : public ModelData {
+public:
+    const uint8_t* address = nullptr;
+    size_t length = 0;
+#ifdef _WIN32
+    HANDLE file = INVALID_HANDLE_VALUE;
+    HANDLE mapping = nullptr;
+    ~MappedModelData() override {
+        if (address) UnmapViewOfFile(address);
+        if (mapping) CloseHandle(mapping);
+        if (file != INVALID_HANDLE_VALUE) CloseHandle(file);
+    }
+#else
+    int file = -1;
+    ~MappedModelData() override {
+        if (address) munmap(const_cast<uint8_t*>(address), length);
+        if (file >= 0) close(file);
+    }
+#endif
+    const uint8_t* data() const noexcept override { return address; }
+    size_t size() const noexcept override { return length; }
+    void release_residency() const noexcept override {
+#ifdef _WIN32
+        // On already-unlocked pages VirtualUnlock removes only this range from
+        // our working set and returns FALSE/ERROR_NOT_LOCKED. Contents remain
+        // mapped, read-only, and available for later dynamic constants.
+        // https://learn.microsoft.com/windows/win32/api/memoryapi/nf-memoryapi-virtualunlock
+        (void)VirtualUnlock(const_cast<uint8_t*>(address), length);
+#else
+        // This is a read-only MAP_PRIVATE file mapping, so all pages are clean:
+        // a later access faults the original file bytes back in, never zeros.
+        (void)madvise(const_cast<uint8_t*>(address), length, MADV_DONTNEED);
+#endif
+    }
+};
+
+[[noreturn]] void mapping_error(const std::string& path, const char* operation) {
+#ifdef _WIN32
+    const std::error_code error(GetLastError(), std::system_category());
+#else
+    const std::error_code error(errno, std::generic_category());
+#endif
+    throw std::runtime_error("Failed to map GGUF file '" + path + "' (" + operation + "): " + error.message());
+}
+} // namespace
+
+std::shared_ptr<ModelData> ModelData::map_file(const std::string& filepath) {
+    auto storage = std::make_shared<MappedModelData>();
+#ifdef _WIN32
+    // Deny writers/deletion while tensors reference this immutable mapping.
+    storage->file = CreateFileW(std::filesystem::u8path(filepath).c_str(), GENERIC_READ,
+                               FILE_SHARE_READ, nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (storage->file == INVALID_HANDLE_VALUE) mapping_error(filepath, "CreateFileW");
+    LARGE_INTEGER size;
+    if (!GetFileSizeEx(storage->file, &size)) mapping_error(filepath, "GetFileSizeEx");
+    if (size.QuadPart <= 0 || static_cast<uint64_t>(size.QuadPart) > std::numeric_limits<size_t>::max())
+        throw std::runtime_error("Cannot map empty or oversized GGUF file: " + filepath);
+    storage->length = static_cast<size_t>(size.QuadPart);
+    storage->mapping = CreateFileMappingW(storage->file, nullptr, PAGE_READONLY, 0, 0, nullptr);
+    if (!storage->mapping) mapping_error(filepath, "CreateFileMappingW");
+    storage->address = static_cast<const uint8_t*>(MapViewOfFile(storage->mapping, FILE_MAP_READ, 0, 0, 0));
+    if (!storage->address) mapping_error(filepath, "MapViewOfFile");
+#else
+    storage->file = open(filepath.c_str(), O_RDONLY | O_CLOEXEC);
+    if (storage->file < 0) mapping_error(filepath, "open");
+    struct stat info;
+    if (fstat(storage->file, &info) != 0) mapping_error(filepath, "fstat");
+    if (!S_ISREG(info.st_mode) || info.st_size <= 0 ||
+        static_cast<uint64_t>(info.st_size) > std::numeric_limits<size_t>::max())
+        throw std::runtime_error("Cannot map empty, nonregular, or oversized GGUF file: " + filepath);
+    storage->length = static_cast<size_t>(info.st_size);
+    void* address = mmap(nullptr, storage->length, PROT_READ, MAP_PRIVATE, storage->file, 0);
+    if (address == MAP_FAILED) mapping_error(filepath, "mmap");
+    storage->address = static_cast<const uint8_t*>(address);
+#endif
+    return storage;
+}
+
+std::shared_ptr<ModelData> ModelData::copy(const uint8_t* data, size_t size) {
+    if (!data || size == 0) throw std::runtime_error("Cannot load empty GGUF buffer");
+    auto storage = std::make_shared<OwnedModelData>();
+    storage->bytes.assign(data, data + size);
+    return storage;
+}
+
+std::shared_ptr<ModelData> ModelData::read_file(const std::string& filepath) {
+    std::ifstream file(std::filesystem::u8path(filepath), std::ios::binary | std::ios::ate);
+    if (!file) throw std::runtime_error("Failed to open GGUF file: " + filepath);
+    const auto size = file.tellg();
+    if (size <= 0 || static_cast<uint64_t>(size) > std::numeric_limits<size_t>::max())
+        throw std::runtime_error("Cannot read empty or oversized GGUF file: " + filepath);
+    auto storage = std::make_shared<OwnedModelData>();
+    storage->bytes.resize(static_cast<size_t>(size));
+    file.seekg(0);
+    if (!file.read(reinterpret_cast<char*>(storage->bytes.data()), size))
+        throw std::runtime_error("Failed to read GGUF file: " + filepath);
+    return storage;
+}
+} // namespace ggmlc
